# Copia este archivo como .env (NO se sube al repositorio) y completa lo que uses.
# Todo es opcional: sin nada, funciona el registro e inicio de sesion con correo y contrasena.

# --- URLs ---
# URL publica desde la que el navegador abre la app. Debe coincidir con la que
# registres en Google/Facebook como "URI de redireccion":
#   {PUBLIC_URL}/api/v1/auth/oauth/google/callback
#   {PUBLIC_URL}/api/v1/auth/oauth/facebook/callback
# En un Codespace es la URL del puerto 8000, p. ej. https://NOMBRE-8000.app.github.dev
PUBLIC_URL=http://localhost:8000
# A donde vuelve el usuario tras iniciar sesion / restablecer contrasena (normalmente igual)
FRONTEND_URL=http://localhost:8000

# --- Cookies ---
# true cuando la app se sirva por HTTPS (Render, Codespaces, produccion)
COOKIE_SECURE=false

# --- Google (https://console.cloud.google.com -> APIs y servicios -> Credenciales -> ID de cliente OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook (https://developers.facebook.com -> Mis apps -> Inicio de sesion con Facebook) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Ajustar a la version vigente del Graph API
FACEBOOK_API_VERSION=v23.0

# --- Correo para recuperar contrasena ---
# log  = no envia nada; imprime el enlace en los logs del servicio (desarrollo/demo)
# smtp = envia por SMTP (p. ej. Gmail con una "contrasena de aplicacion")
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Sesiones (valores por defecto) ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=60

# --- Llave de firma JWT (opcional) ---
# Por defecto se genera sola y se guarda en el volumen. Para fijarla (varias
# replicas, Kubernetes): PEM en una linea con \n en lugar de saltos de linea.
# JWT_PRIVATE_KEY=
