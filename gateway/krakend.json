{
  "version": 3,
  "name": "API Gateway - Social Medi4",
  "port": 9000,
  "endpoints": [
    {
      "endpoint": "/gateway/benefits",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/benefits/all",
          "host": ["http://host.docker.internal:8001"]
        }
      ]
    },
    {
      "endpoint": "/gateway/benefits",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/benefits/",
          "host": ["http://host.docker.internal:8001"]
        }
      ]
    },
    {
      "endpoint": "/gateway/users",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/users",
          "host": ["http://host.docker.internal:8000"]
        }
      ]
    }
  ]
}